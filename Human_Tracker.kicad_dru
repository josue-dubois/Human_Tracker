# =====================================================================
#  JLCPCB manufacturing rules for KiCad (custom design rules)
#  Source: https://jlcpcb.com/capabilities/pcb-capabilities (2026-10)
#  Assumes FR-4, 1 oz finished copper, standard (non-HDI) process.
#  Where 2-layer and multilayer limits differ, the stricter value that is
#  valid for BOTH is used. See comments to adjust for 2 oz / V-score / HDI.
# =====================================================================
(version 1)

# ---------------------------------------------------------------- copper
# Min. track width, 1 oz: 1-2 layer 0.10 mm / multilayer 0.09 mm
(rule "JLC min track width (1 oz)"
    (constraint track_width (min 0.10mm)))

# Min. copper spacing, 1 oz: 1-2 layer 0.10 mm / multilayer 0.09 mm
# NOTE: a global clearance rule overrides the netclass value. Delete or raise
# this if you want your 0.2 mm Default netclass to remain the floor.
(rule "JLC min clearance (1 oz)"
    (constraint clearance (min 0.10mm)))

# Min. hole-to-copper clearance (via hole to track / inner-layer hole to copper)
(rule "JLC min hole clearance"
    (constraint hole_clearance (min 0.20mm)))

# ---------------------------------------------------------------- drilling
# Min. via hole 0.15 mm (0.20 mm preferred, cheaper); max drill 6.30 mm
(rule "JLC min drill size"
    (constraint hole_size (min 0.15mm) (max 6.30mm)))

# Min. via diameter 0.25 mm (via pad must be >= hole + 0.10 mm)
(rule "JLC min via diameter"
    (constraint via_diameter (min 0.25mm)))

# Min. via hole-to-hole 0.20 mm (pad hole-to-hole 0.45 mm not enforced here)
(rule "JLC min hole-to-hole"
    (constraint hole_to_hole (min 0.20mm)))

# Annular ring, 1 oz: 2-layer abs. 0.18 mm, multilayer abs. 0.15 mm.
# 0.18 mm keeps this valid for both; JLCPCB recommends 0.20-0.25 mm.
(rule "JLC min annular ring"
    (constraint annular_width (min 0.18mm)))

# Standard process = through-hole vias only (no micro/blind/buried vias)
(rule "JLC no micro/buried vias"
    (constraint disallow micro_via buried_via))

# ---------------------------------------------------------------- outline
# Copper clearance to routed edge/slots >= 0.20 mm (use 0.40 mm for V-score)
(rule "JLC copper to routed edge"
    (constraint edge_clearance (min 0.20mm)))

# ---------------------------------------------------------------- silkscreen
# Min. silk line width 0.15 mm
(rule "JLC min silk line width"
    (condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
    (constraint text_thickness (min 0.15mm)))

# Min. silk text height 0.8 mm (1.0 mm recommended for legibility)
(rule "JLC min silk text height"
    (condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
    (constraint text_height (min 0.8mm)))

# Min. silkscreen to pad / solder-mask opening 0.15 mm
(rule "JLC silk clearance"
    (constraint silk_clearance (min 0.15mm)))

# ---------------------------------------------------------------- optional
# Solder mask is NOT settable as a custom rule in KiCad 9/10. JLCPCB uses a
# 1:1 mask opening (LDI); set Solder Mask expansion in Board Setup (0 is fine,
# JLC adjusts in CAM). Min. mask bridge: 0.10 mm (0.13 mm black/white, 2 oz 0.20).
#
# Example USB 2.0 differential pair rule (uncomment after making a "USB" class):
# (rule "USB diff pair gap"
#     (condition "A.hasNetclass('USB')")
#     (constraint diff_pair_gap (min 0.15mm) (max 0.35mm)))
